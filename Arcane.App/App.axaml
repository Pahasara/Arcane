<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels"
             xmlns:vmAuth="using:Arcane.App.ViewModels.Auth"
             xmlns:vmEntries="using:Arcane.App.ViewModels.Entries"
             xmlns:vmTags="using:Arcane.App.ViewModels.Tags"
             xmlns:viewsAuth="using:Arcane.App.Views.Auth"
             xmlns:viewsShell="using:Arcane.App.Views.Shell"
             xmlns:viewsEntries="using:Arcane.App.Views.Entries"
             xmlns:viewsTags="using:Arcane.App.Views.Tags"
             x:Class="Arcane.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="ArcaneBackground">#070A12</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneSurface">#0C111B</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneSurfaceRaised">#090E16</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneSurfaceHover">#101824</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneControlHover">#0B1A2B</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneControlPressed">#081321</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneBorder">#172238</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneText">#E8ECF4</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneTextMuted">#8290A8</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneAccent">#46A7FF</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneAccentHover">#70C9FF</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneAccentPressed">#1C9BE8</SolidColorBrush>
        <SolidColorBrush x:Key="ArcaneDanger">#F87171</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/GitHubTheme.axaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <Style Selector="Window, UserControl">
            <Setter Property="FontFamily" Value="avares://Arcane/Assets/Fonts#Comic Sans MS" />
        </Style>
        <Style Selector="TextBlock.nerd-icon">
            <Setter Property="FontFamily" Value="avares://Arcane/Assets/Fonts#CaskaydiaMono Nerd Font Mono" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.nerd-icon">
            <Setter Property="FontFamily" Value="avares://Arcane/Assets/Fonts#CaskaydiaMono Nerd Font Mono" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.mood-btn">
            <Setter Property="FontFamily" Value="Noto Color Emoji, Segoe UI Emoji, Apple Color Emoji" />
        </Style>
        <Style Selector="TextBlock.mood-emoji">
            <Setter Property="FontFamily" Value="Noto Color Emoji, Segoe UI Emoji, Apple Color Emoji" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ArcaneSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccentPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
        </Style>
        <Style Selector="Button:focus">
            <Setter Property="Background" Value="{DynamicResource ArcaneSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneText}" />
        </Style>
        <Style Selector="Button:pointerover:focus">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource ArcaneAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccentPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
        </Style>
        <Style Selector="Button.ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccentPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
        </Style>
        <Style Selector="Button.ghost:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:pointerover:focus">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource ArcaneDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneDanger}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource ArcaneBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneBorder}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
            <Setter Property="Background" Value="#0C1422" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="TextBox:pointerover:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0.72" />
        </Style>
    </Application.Styles>

    <Application.DataTemplates>

        <DataTemplate DataType="{x:Type vmAuth:SetupViewModel}">
            <viewsAuth:SetupView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmAuth:UnlockViewModel}">
            <viewsAuth:UnlockView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainShellViewModel}">
            <viewsShell:MainShellView />
        </DataTemplate>

        <!-- Phase 2: editor resolved by ContentControl inside MainShellView -->
        <DataTemplate DataType="{x:Type vmEntries:EntryEditorViewModel}">
            <viewsEntries:EntryEditorView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vmTags:TagManagerViewModel}">
            <viewsTags:TagManagerView />
        </DataTemplate>

    </Application.DataTemplates>

</Application>
