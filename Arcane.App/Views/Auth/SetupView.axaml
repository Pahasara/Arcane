<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels.Auth"
             xmlns:conv="using:Arcane.App.Converters"
             x:DataType="vm:SetupViewModel"
             x:Class="Arcane.App.Views.Auth.SetupView"
             Background="{DynamicResource ArcaneSurface}">

    <!-- Full-screen centered card layout -->
    <Grid>
        <Border Padding="28,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">

            <StackPanel Spacing="0">

                <!-- Logo / wordmark -->
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,24">
                    <TextBlock Text=""
                               Classes="nerd-icon"
                               FontSize="42"
                               Foreground="{DynamicResource ArcaneAccent}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Arcane"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ArcaneText}"
                               HorizontalAlignment="Center"
                               LetterSpacing="3" />
                    <TextBlock Text="Your thoughts. Yours alone."
                               FontSize="12"
                               Foreground="{DynamicResource ArcaneTextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Section heading -->
                <TextBlock Text="Create your vault"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ArcaneText}"
                           Margin="0,0,0,20" />

                <!-- Password field -->
                <TextBlock Text="Master password"
                           FontSize="12"
                           Foreground="{DynamicResource ArcaneTextMuted}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Password, Mode=TwoWay}"
                         PasswordChar="{Binding ShowPassword,
                                        Converter={x:Static conv:BoolToPasswordCharConverter.Instance}}"
                         PlaceholderText="Choose a strong password"
                         Background="{DynamicResource ArcaneBackground}"
                         Foreground="{DynamicResource ArcaneText}"
                         BorderBrush="{DynamicResource ArcaneBorder}"
                         CornerRadius="8"
                         Padding="12,10"
                         Margin="0,0,0,4"
                         KeyDown="OnPasswordKeyDown">
                    <TextBox.InnerRightContent>
                        <Button Command="{Binding ToggleShowPasswordCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,0"
                                Cursor="Hand"
                                >
                                <TextBlock Text="󰈈" Classes="nerd-icon" FontSize="18" />
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>

                <!-- Password strength indicator -->
                <TextBlock Text="{Binding PasswordStrength}"
                           FontSize="12"
                           Margin="2,4,0,16"
                           Foreground="{Binding PasswordStrength,
                                        Converter={x:Static conv:StrengthToColorConverter.Instance}}"
                           IsVisible="{Binding Password.Length,
                                       Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Confirm password field -->
                <TextBlock Text="Confirm password"
                           FontSize="12"
                           Foreground="{DynamicResource ArcaneTextMuted}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}"
                         PasswordChar="{Binding ShowPassword,
                                        Converter={x:Static conv:BoolToPasswordCharConverter.Instance}}"
                         PlaceholderText="Repeat your password"
                         Background="{DynamicResource ArcaneBackground}"
                         Foreground="{DynamicResource ArcaneText}"
                         BorderBrush="{DynamicResource ArcaneBorder}"
                         CornerRadius="8"
                         Padding="12,10"
                         Margin="0,0,0,20"
                         KeyDown="OnConfirmPasswordKeyDown" />

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ArcaneDanger}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           IsVisible="{Binding ErrorMessage,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Create button -->
                <Button Command="{Binding CreateVaultCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="accent"
                        Foreground="#FFFFFF"
                        CornerRadius="8"
                        Padding="0,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Content>
                        <Panel>
                            <TextBlock Text="Create vault"
                                       IsVisible="{Binding !IsBusy}"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsVisible="{Binding IsBusy}"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Creating vault…" />
                            </StackPanel>
                        </Panel>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>