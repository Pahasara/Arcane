<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels.Auth"
             xmlns:conv="using:Arcane.App.Converters"
             x:DataType="vm:UnlockViewModel"
             x:Class="Arcane.App.Views.Auth.UnlockView"
             Background="{DynamicResource ArcaneSurface}">

    <UserControl.Styles>
        <!-- Shake animation: fires when ShakeError becomes true -->
        <Style Selector="Border.shake">
            <Style.Animations>
                <Animation Duration="0:0:0.4" FillMode="Forward"
                           PlaybackDirection="Normal"
                           IterationCount="1">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="20%">
                        <Setter Property="TranslateTransform.X" Value="-10" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="TranslateTransform.X" Value="10" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="TranslateTransform.X" Value="-8" />
                    </KeyFrame>
                    <KeyFrame Cue="80%">
                        <Setter Property="TranslateTransform.X" Value="8" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Padding="28,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">

            <StackPanel Spacing="0">

                <!-- Logo / wordmark -->
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,24">
                    <TextBlock Text=""
                               Classes="nerd-icon"
                               FontSize="42"
                               Foreground="{DynamicResource ArcaneAccent}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Arcane"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ArcaneText}"
                               HorizontalAlignment="Center"
                               LetterSpacing="3" />
                    <TextBlock Text="Your thoughts. Yours alone."
                               FontSize="12"
                               Foreground="{DynamicResource ArcaneTextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Unlock your vault"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ArcaneText}"
                           Margin="0,0,0,16" />

                <!--
                    Password input wrapped in a Border so we can apply the shake animation.
                    The Border gets the "shake" class when ShakeError is true,
                    which triggers the Style animation defined above.
                -->
                <Border x:Name="PasswordBorder"
                        Margin="0,0,0,8"
                        Classes.shake="{Binding ShakeError}">
                    <TextBlock Text="Master password"
                               FontSize="12"
                               Foreground="{DynamicResource ArcaneTextMuted}"
                               Margin="0,0,0,6" />
                </Border>

                <!-- Separate border wrapping just the TextBox for the shake effect -->
                <Border Classes.shake="{Binding ShakeError}"
                        Margin="0,0,0,20">
                    <TextBox Text="{Binding Password, Mode=TwoWay}"
                             PasswordChar="{Binding ShowPassword,
                                            Converter={x:Static conv:BoolToPasswordCharConverter.Instance}}"
                             PlaceholderText="Enter your master password"
                             Background="{DynamicResource ArcaneBackground}"
                             Foreground="{DynamicResource ArcaneText}"
                             BorderBrush="{DynamicResource ArcaneBorder}"
                             CornerRadius="8"
                             Padding="12,10"
                             KeyDown="OnPasswordKeyDown">
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding ToggleShowPasswordCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,0"
                                    Cursor="Hand">
                                <TextBlock Text="󰈈" Classes="nerd-icon" FontSize="18" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </Border>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ArcaneDanger}"
                           FontSize="13"
                           Margin="0,0,0,16"
                           IsVisible="{Binding ErrorMessage,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Unlock button -->
                <Button Command="{Binding UnlockCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="accent"
                        Foreground="#FFFFFF"
                        CornerRadius="8"
                        Padding="0,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,0,20">
                    <Button.Content>
                        <Panel>
                            <TextBlock Text="Unlock"
                                       IsVisible="{Binding !IsBusy}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Unlocking…"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalAlignment="Center" />
                        </Panel>
                    </Button.Content>
                </Button>

                <!-- Vault creation date hint -->
                <TextBlock Text="{Binding VaultHint}"
                           FontSize="12"
                           Foreground="{DynamicResource ArcaneTextMuted}"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding VaultHint,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            </StackPanel>
        </Border>
    </Grid>

</UserControl>