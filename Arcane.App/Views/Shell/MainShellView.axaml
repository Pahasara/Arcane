<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels"
             xmlns:viewsEntries="using:Arcane.App.Views.Entries"
             x:DataType="vm:MainShellViewModel"
             x:Class="Arcane.App.Views.Shell.MainShellView"
             Background="{DynamicResource ArcaneBackground}">

    <UserControl.Styles>
        <Style Selector="Button.sidebar-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.sidebar-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.sidebar-action:pressed">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccentPressed}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="280,1,*">

        <!-- Column 0: Sidebar -->
        <DockPanel Grid.Column="0" Background="{DynamicResource ArcaneSurface}">

            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource ArcaneBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text=""
                                   Classes="nerd-icon"
                                   FontSize="30"
                                   Foreground="{DynamicResource ArcaneAccent}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Arcane"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ArcaneText}"
                                   VerticalAlignment="Center"
                                   LetterSpacing="1.5" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding EntryList.NewEntryCommand}"
                            Classes="sidebar-action"
                            Padding="8,6"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="＋"
                                   FontSize="18"
                                   Foreground="{DynamicResource ArcaneAccent}"
                                   FontWeight="Bold" />
                    </Button>
                    
                    <Button Grid.Column="2"
                            Command="{Binding LockCommand}"
                            Classes="sidebar-action"
                            Padding="8,6"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text=""
                                   Classes="nerd-icon"
                                   FontSize="20"
                                   Foreground="{DynamicResource ArcaneTextMuted}" />
                    </Button>
                </Grid>
            </Border>

            <viewsEntries:EntryListView DataContext="{Binding EntryList}" />

        </DockPanel>

        <!-- Column 1: Divider -->
        <Border Grid.Column="1" Background="{DynamicResource ArcaneBorder}" />

        <!-- Column 2: Editor panel -->
        <Grid Grid.Column="2">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        IsVisible="{Binding CurrentEditor,
                                    Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="󰠮"
                           Classes="nerd-icon"
                           FontSize="52"
                           Foreground="{DynamicResource ArcaneAccent}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select an entry or create a new one"
                           FontSize="14"
                           Foreground="{DynamicResource ArcaneTextMuted}"
                           HorizontalAlignment="Center" />
                <Button Content="＋ New entry"
                        Command="{Binding EntryList.NewEntryCommand}"
                        Classes="accent"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="20,11"
                        HorizontalAlignment="Center"
                        Cursor="Hand" />
            </StackPanel>

            <ContentControl Content="{Binding CurrentEditor}"
                            IsVisible="{Binding CurrentEditor,
                                        Converter={x:Static ObjectConverters.IsNotNull}}" />

        </Grid>
    </Grid>

</UserControl>
