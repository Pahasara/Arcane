<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels.Entries"
             xmlns:dto="using:Arcane.Core.Models.DTOs"
             xmlns:conv="using:Arcane.App.Converters"
             x:DataType="vm:EntryListViewModel"
             x:Class="Arcane.App.Views.Entries.EntryListView"
             Background="#1A1A24">

    <DockPanel>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Foreground="#7C3AED"
                     Background="Transparent"
                     Height="2" />

        <ListBox ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6,4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding"      Value="0" />
                    <Setter Property="Margin"       Value="0,1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background"   Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="#2A2A3E" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#222232" />
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dto:EntryDto">
                    <Border Padding="12,10" CornerRadius="8">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E2F0"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0" />

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Mood,
                                              Converter={x:Static conv:MoodToEmojiConverter.Instance}}"
                                       FontSize="14"
                                       IsVisible="{Binding Mood,
                                                   Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{Binding CreatedAt,
                                              Converter={x:Static conv:RelativeDateConverter.Instance}}"
                                       FontSize="12"
                                       Foreground="#8888AA"
                                       Margin="0,3,0,0" />

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="⭐"
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       IsVisible="{Binding IsFavorite}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </DockPanel>

</UserControl>