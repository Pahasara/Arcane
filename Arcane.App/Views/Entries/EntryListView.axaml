<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels.Entries"
             xmlns:dto="using:Arcane.Core.Models.DTOs"
             xmlns:entities="using:Arcane.Core.Models.Entities"
             xmlns:conv="using:Arcane.App.Converters"
             xmlns:controls="using:Arcane.App.Controls"
             x:DataType="vm:EntryListViewModel"
             x:Class="Arcane.App.Views.Entries.EntryListView"
             Background="{DynamicResource ArcaneSurface}">

    <UserControl.Styles>
    </UserControl.Styles>

    <DockPanel>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Foreground="{DynamicResource ArcaneAccent}"
                     Background="Transparent"
                     Height="2" />

        <!-- ── Tag filter bar ── -->
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      IsVisible="{Binding AvailableTags.Count}"
                      Padding="16,12,16,6">
            <ItemsControl ItemsSource="{Binding AvailableTags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:Tag">
                        <controls:TagChip x:Name="Chip"
                                TagData="{Binding}"
                                IsToggleActive="{Binding $parent[UserControl].((vm:EntryListViewModel)DataContext).ActiveTagFilters,
                                            Converter={x:Static conv:TagInCollectionConverter.Instance},
                                            ConverterParameter={Binding}}"
                                Loaded="OnTagChipLoaded" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Entry list ── -->
        <ListBox ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="12,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding"      Value="0" />
                    <Setter Property="Margin"       Value="0,3" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background"   Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ArcaneAccent}" />
                </Style>
                <Style Selector="ListBoxItem:pointerover TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
                </Style>
                <Style Selector="ListBoxItem TextBlock.entry-title">
                    <Setter Property="Foreground" Value="{DynamicResource ArcaneText}" />
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock.entry-title">
                    <Setter Property="Foreground" Value="{DynamicResource ArcaneAccent}" />
                </Style>
                <Style Selector="ListBoxItem:pointerover TextBlock.entry-title">
                    <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dto:EntryDto">
                    <Border Background="{DynamicResource ArcaneSurface}"
                            Padding="16,13"
                            CornerRadius="10">
                        <StackPanel Spacing="4">

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Classes="entry-title"
                                           Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" />

                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock
                                           Text="{Binding Mood,
                                                  Converter={x:Static conv:MoodToEmojiConverter.Instance}}"
                                           Classes="mood-emoji"
                                           FontSize="14"
                                           IsVisible="{Binding Mood,
                                                       Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text=""
                                               Classes="nerd-icon"
                                               FontSize="16"
                                               Foreground="{DynamicResource ArcaneAccent}"
                                               IsVisible="{Binding IsFavorite}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            Margin="0,3,0,0">
                                    <TextBlock Text="{Binding CreatedAt,
                                                       Converter={x:Static conv:LocalDateTimeConverter.Instance},
                                                       StringFormat='Created {0:dd MMM yyyy HH:mm}'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ArcaneTextMuted}" />
                                    <TextBlock Text="{Binding UpdatedAt,
                                                       Converter={x:Static conv:LocalDateTimeConverter.Instance},
                                                       StringFormat='Updated {0:dd MMM yyyy HH:mm}'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ArcaneTextMuted}" />
                                </StackPanel>

                            </Grid>

                            <!-- Tag chips on the entry card (display-only, non-removable) -->
                            <ItemsControl ItemsSource="{Binding Tags}"
                                          IsVisible="{Binding Tags.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Tag">
                                        <controls:TagChip TagData="{Binding}" Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </DockPanel>

</UserControl>
