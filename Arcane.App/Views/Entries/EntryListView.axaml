<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels.Entries"
             xmlns:dto="using:Arcane.Core.Models.DTOs"
             xmlns:entities="using:Arcane.Core.Models.Entities"
             xmlns:conv="using:Arcane.App.Converters"
             xmlns:controls="using:Arcane.App.Controls"
             x:DataType="vm:EntryListViewModel"
             x:Class="Arcane.App.Views.Entries.EntryListView"
             Background="#1A1A24">

    <UserControl.Styles>
        <Style Selector="Button.mood-filter-btn">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush"     Value="Transparent" />
            <Setter Property="CornerRadius"    Value="16" />
            <Setter Property="Width"           Value="30" />
            <Setter Property="Height"          Value="30" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="FontSize"        Value="15" />
            <Setter Property="Cursor"          Value="Hand" />
        </Style>
        <Style Selector="Button.mood-filter-btn.active">
            <Setter Property="BorderBrush" Value="#7C3AED" />
        </Style>
        <Style Selector="Button.mood-filter-btn:pointerover">
            <Setter Property="Background" Value="#2A2A3E" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Foreground="#7C3AED"
                     Background="Transparent"
                     Height="2" />

        <!-- ── Tag filter bar ── -->
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      IsVisible="{Binding AvailableTags.Count}"
                      Padding="10,8,10,4">
            <ItemsControl ItemsSource="{Binding AvailableTags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:Tag">
                        <controls:TagChip x:Name="Chip"
                                TagData="{Binding}"
                                IsToggleActive="{Binding $parent[UserControl].((vm:EntryListViewModel)DataContext).ActiveTagFilters,
                                            Converter={x:Static conv:TagInCollectionConverter.Instance},
                                            ConverterParameter={Binding}}"
                                Loaded="OnTagChipLoaded" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Mood filter bar ── -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="10,0,10,8">
            <Button Classes="mood-filter-btn" Content="😞" Tag="Awful"
                    Click="OnMoodFilterClicked" ToolTip.Tip="Awful" />
            <Button Classes="mood-filter-btn" Content="😕" Tag="Bad"
                    Click="OnMoodFilterClicked" ToolTip.Tip="Bad" />
            <Button Classes="mood-filter-btn" Content="😐" Tag="Neutral"
                    Click="OnMoodFilterClicked" ToolTip.Tip="Neutral" />
            <Button Classes="mood-filter-btn" Content="🙂" Tag="Good"
                    Click="OnMoodFilterClicked" ToolTip.Tip="Good" />
            <Button Classes="mood-filter-btn" Content="😊" Tag="Great"
                    Click="OnMoodFilterClicked" ToolTip.Tip="Great" />
        </StackPanel>

        <!-- ── Entry list ── -->
        <ListBox ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6,4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding"      Value="0" />
                    <Setter Property="Margin"       Value="0,1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background"   Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="#2A2A3E" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#222232" />
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dto:EntryDto">
                    <Border Padding="12,10" CornerRadius="8">
                        <StackPanel Spacing="4">

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E2F0"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" />

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Mood,
                                                  Converter={x:Static conv:MoodToEmojiConverter.Instance}}"
                                           FontSize="14"
                                           IsVisible="{Binding Mood,
                                                       Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding CreatedAt,
                                                  Converter={x:Static conv:RelativeDateConverter.Instance}}"
                                           FontSize="12"
                                           Foreground="#8888AA"
                                           Margin="0,3,0,0" />

                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="⭐"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           IsVisible="{Binding IsFavorite}" />
                            </Grid>

                            <!-- Tag chips on the entry card (display-only, non-removable) -->
                            <ItemsControl ItemsSource="{Binding Tags}"
                                          IsVisible="{Binding Tags.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Tag">
                                        <controls:TagChip TagData="{Binding}" Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </DockPanel>

</UserControl>
