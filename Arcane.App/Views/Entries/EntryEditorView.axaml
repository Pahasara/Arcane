<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcane.App.ViewModels.Entries"
             xmlns:controls="using:Arcane.App.Controls"
             xmlns:conv="using:Arcane.App.Converters"
             xmlns:entities="using:Arcane.Core.Models.Entities"
             x:DataType="vm:EntryEditorViewModel"
             x:Class="Arcane.App.Views.Entries.EntryEditorView"
             Background="{DynamicResource ArcaneBackground}">

    <UserControl.Styles>
        <Style Selector="Button.toolbar-action">
            <Setter Property="Background" Value="{DynamicResource ArcaneSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneBorder}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.toolbar-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource ArcaneAccentHover}" />
        </Style>
        <Style Selector="Button.toolbar-action:pressed">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccentPressed}" />
        </Style>
        <Style Selector="Button.toolbar-action:focus">
            <Setter Property="Background" Value="{DynamicResource ArcaneSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneBorder}" />
        </Style>
        <Style Selector="Button.toolbar-action:pointerover:focus">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.icon-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.icon-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.icon-action:pressed">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccentPressed}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Row 0: Title + Toolbar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="32,18,32,0">

            <TextBox x:Name="TitleBox"
                     Grid.Column="0"
                     Text="{Binding Title, Mode=TwoWay}"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{DynamicResource ArcaneText}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,8"
                     MinHeight="44"
                     PlaceholderText="Untitled"
                     VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

                <Button Command="{Binding OpenTagManagerCommand}"
                        Classes="toolbar-action"
                        MinWidth="64"
                        MinHeight="36"
                        Padding="10,4"
                        Content="Tags"
                        Cursor="Hand" />

                <TextBlock Text="{Binding SaveStatus}"
                           FontSize="12"
                           Foreground="{DynamicResource ArcaneTextMuted}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding SaveStatus,
                                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Button Command="{Binding ToggleFavoriteCommand}"
                        Classes="icon-action"
                        BorderThickness="0"
                        MinWidth="42"
                        MinHeight="36"
                        Padding="8,4"
                        HorizontalContentAlignment="Center"
                        Cursor="Hand"
                        >

                    <TextBlock Text="{Binding IsFavorite,
                                              Converter={x:Static conv:BoolToStarConverter.Instance}}"
                               Classes="nerd-icon"
                               FontSize="18" />
                </Button>

                <Button Command="{Binding RequestDeleteCommand}"
                        Classes="icon-action"
                        BorderThickness="0"
                        MinWidth="42"
                        MinHeight="36"
                        Padding="8,4"
                        HorizontalContentAlignment="Center"
                        Cursor="Hand"
                        IsVisible="{Binding !ShowDeleteConfirm}">

                    <TextBlock Text=""
                               Classes="nerd-icon"
                               FontSize="18" />
                </Button>

            </StackPanel>
        </Grid>

        <!-- Row 1: Date + Mood Picker -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="32,8,32,10">

            <TextBlock Grid.Column="0"
                       Text="{Binding CreatedAt,
                                      Converter={x:Static conv:LocalDateTimeConverter.Instance},
                                      StringFormat='{}{0:dddd, dd MMMM yyyy}'}"
                       FontSize="13"
                       Foreground="{DynamicResource ArcaneTextMuted}"
                       VerticalAlignment="Center" />

            <controls:MoodPicker Grid.Column="1"
                                 SelectedMood="{Binding SelectedMood, Mode=TwoWay}"
                                 VerticalAlignment="Center" />
        </Grid>

        <!-- Row 2: Tags -->
        <Border Grid.Row="2"
                Margin="32,0,32,14">

            <StackPanel Orientation="Horizontal"
                        Spacing="6">

                <ItemsControl ItemsSource="{Binding AssignedTags}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="entities:Tag">

                            <controls:TagChip TagData="{Binding}"
                                              IsRemovable="True"
                                              Margin="0,0,6,0"
                                              RemoveRequested="OnTagRemoveRequested" />

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- Add Tag Button -->
                <Button Command="{Binding OpenTagPickerCommand}"
                        Content="+ Add tag"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ArcaneBorder}"
                        BorderThickness="1"
                        Foreground="{DynamicResource ArcaneTextMuted}"
                        FontSize="12"
                        CornerRadius="12"
                        Padding="10,4"
                        MinWidth="92"
                        MinHeight="32"
                        Cursor="Hand" />

                <!-- Tag Picker -->
                <Popup IsOpen="{Binding ShowTagPicker}"
                       PlacementTarget="{Binding $parent[Border]}"
                       Placement="BottomEdgeAlignedLeft">

                    <Border Background="{DynamicResource ArcaneSurface}"
                            BorderBrush="{DynamicResource ArcaneBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            MinWidth="160"
                            MaxHeight="200">

                        <ScrollViewer>

                            <ItemsControl ItemsSource="{Binding UnassignedTags}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Tag">

                                        <Button Content="{Binding Name}"
                                                Command="{Binding $parent[Popup].((vm:EntryEditorViewModel)DataContext).AddTagCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource ArcaneText}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6"
                                                Cursor="Hand" />

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>
                    </Border>
                </Popup>

            </StackPanel>
        </Border>

        <!-- Row 3: Markdown Editor -->
        <controls:MarkdownEditor Grid.Row="3"
                                 Text="{Binding Content, Mode=TwoWay}" />

        <!-- Row 4: Error Message -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource ArcaneDanger}"
                   FontSize="12"
                   Margin="24,4"
                   IsVisible="{Binding ErrorMessage,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Row 4: Delete Confirmation Banner -->
        <Border Grid.Row="4"
                Background="{DynamicResource ArcaneSurface}"
                BorderBrush="{DynamicResource ArcaneDanger}"
                BorderThickness="0,1,0,0"
                Padding="24,12"
                IsVisible="{Binding ShowDeleteConfirm}">

            <Grid ColumnDefinitions="*,Auto,Auto">

                <TextBlock Grid.Column="0"
                           Text="Delete this entry? This cannot be undone."
                           Foreground="{DynamicResource ArcaneText}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="Delete"
                        Command="{Binding ConfirmDeleteCommand}"
                        Classes="danger"
                        Foreground="White"
                        CornerRadius="6"
                        Padding="16,6"
                        MinWidth="88"
                        MinHeight="36"
                        Margin="0,0,8,0"
                        Cursor="Hand" />

                <Button Grid.Column="2"
                        Content="Cancel"
                        Command="{Binding CancelDeleteCommand}"
                        Background="{DynamicResource ArcaneSurfaceRaised}"
                        Foreground="{DynamicResource ArcaneText}"
                        CornerRadius="6"
                        Padding="16,6"
                        MinWidth="88"
                        MinHeight="36"
                        Cursor="Hand" />

            </Grid>
        </Border>

    </Grid>

</UserControl>
