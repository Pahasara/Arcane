<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Arcane.App.Controls.MoodPicker">

    <UserControl.Styles>
        <Style Selector="Button.mood-btn">
            <Setter Property="Background"                   Value="Transparent" />
            <Setter Property="BorderThickness"              Value="2" />
            <Setter Property="BorderBrush"                  Value="Transparent" />
            <Setter Property="CornerRadius"                 Value="20" />
            <Setter Property="Width"                        Value="36" />
            <Setter Property="Height"                       Value="36" />
            <Setter Property="Padding"                      Value="0" />
            <Setter Property="Cursor"                       Value="Hand" />
            <Setter Property="FontSize"                     Value="18" />
            <Setter Property="HorizontalContentAlignment"   Value="Center" />
            <Setter Property="VerticalContentAlignment"     Value="Center" />
        </Style>
        <Style Selector="Button.mood-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.mood-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccentPressed}" />
        </Style>
        <Style Selector="Button.mood-btn:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.mood-btn:pointerover:focus">
            <Setter Property="Background" Value="{DynamicResource ArcaneControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.mood-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
        <Style Selector="Button.mood-btn.selected:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ArcaneAccent}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="BtnAwful"   Classes="mood-btn" Content="😞" />
        <Button x:Name="BtnBad"     Classes="mood-btn" Content="😕" />
        <Button x:Name="BtnNeutral" Classes="mood-btn" Content="😐" />
        <Button x:Name="BtnGood"    Classes="mood-btn" Content="🙂" />
        <Button x:Name="BtnGreat"   Classes="mood-btn" Content="😊" />
    </StackPanel>

</UserControl>